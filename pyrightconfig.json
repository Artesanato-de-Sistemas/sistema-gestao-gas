{
  "include": ["backend"],
  "venvPath": "backend",
  "venv": ".venv",
  "pythonVersion": "3.13",
  "pythonPlatform": "Windows",
  "typeCheckingMode": "basic",
  "reportMissingImports": false,
  "reportMissingModuleSource": false,
  "reportAttributeAccessIssue": false,
  "exclude": [
    "backend/**/__pycache__",
    "backend/**/migrations",
    "frontend"
  ]
}
